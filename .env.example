# ==============================================================================
# Snowflake Connection Configuration
# ==============================================================================
# Copy this file to '.env' and fill in your actual Snowflake credentials.
# NEVER commit your actual '.env' file containing real secrets to version control.
# ==============================================================================

# Your Snowflake Account identifier (e.g., xy12345.us-east-1 or org-account)
SNOWFLAKE_ACCOUNT=your_snowflake_account

# Snowflake user login name
SNOWFLAKE_USER=your_snowflake_user

# Snowflake user password
SNOWFLAKE_PASSWORD=your_snowflake_password

# Compute warehouse to execute queries (e.g., COMPUTE_WH)
SNOWFLAKE_WAREHOUSE=COMPUTE_WH

# Target Database name
SNOWFLAKE_DATABASE=MEDICAPS_RETAIL

# Target Schema name containing the Gold layer tables
SNOWFLAKE_SCHEMA=GOLD
